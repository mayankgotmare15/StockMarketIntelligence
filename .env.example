# ==============================================================================
# Real-Time Indian Stock Market Intelligence Platform (v4) - Environment Config
# ==============================================================================

# Supabase Credentials (PostgreSQL Cloud Storage)
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-anon-or-service-role-key

# Storage Paths
LOCAL_STORAGE_DIR=./data
DUCKDB_PATH=./data/market_intelligence.duckdb
PARQUET_DIR=./data/parquet
REPORT_DIR=./reports

# Data Ingestion Settings
MIN_TRADING_DAYS_HISTORY=400
INGESTION_START_DATE=2022-01-01
INGESTION_MAX_RETRIES=3
INGESTION_RETRY_BACKOFF_SECONDS=2

# Walk-Forward Cross-Validation Hyperparameters
WF_TRAIN_DAYS=252       # 1 trading year
WF_TEST_DAYS=21         # 1 trading month
WF_STEP_DAYS=21         # 1 trading month sliding step
SEQUENCE_LOOKBACK_DAYS=10

# Base Learner Hyperparameters (Liu et al. 2024 Topology)
LSTM_UNITS=100
LSTM_LAYERS=2
LSTM_DROPOUT=0.20
ANN_HIDDEN_1=100
ANN_HIDDEN_2=50
LEARNING_RATE=0.001
BATCH_SIZE=32
EPOCHS=60
RANDOM_SEED=42

# Adaptive Meta-Model Hyperparameters (Our Novelty Contribution)
DRIFT_WINDOW_DAYS=30
DRIFT_Z_THRESHOLD=2.0
ADAPTIVE_REFIT_LOOKBACK_DAYS=60
RIDGE_ALPHA=1.0
ATR_WINDOW_DAYS=20

# System Logging
LOG_LEVEL=INFO
